@*@model IEnumerable<EURIS.Entities.Product>*@
@model IPagedList<EURIS.Entities.Product>

@using PagedList.Mvc;
@using PagedList;
@{
    ViewBag.Title = "Index";
    int filterRes = Convert.ToInt16(ViewData["filterResult"]);
    var countProducts = ViewData["Result"];
}

<h2>Catalog page</h2>

<br />

<div class="form-group">
    @using (Html.BeginForm("Index", "Catalog", FormMethod.Get))
    {
        <input type="text" name="search" value="Code..." id="codeSearch"/>
        <input type="submit"  value="Search" />
    }

</div>
<table class="table">
    <tr>
        <th>
            @Html.ActionLink("ID", "Index", new { sort = ViewData["IDSortParm"], search = Request.QueryString["search"] })
        </th>
        <th>

            @Html.ActionLink("Code", "Index", new { sort = ViewData["CodeSortParm"], search = Request.QueryString["search"] })
        </th>
        <th>
            Description
        </th>
    </tr>

    @if (Model.Count > 0)
    {
        foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Code)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
            </tr>
        }
    }
    else
    {
        <h1>No records found</h1>
    }

</table>


<br/>
<p>Found : @countProducts</p>

<div class="pagination">
    @Html.PagedListPager(Model, page => Url.Action("Index", "Catalog", new { page, search = Request.QueryString["search"] }))
</div>


<script type="text/javascript">
    var filter = @filterRes;
    if (filter == 1) {
        $("#codeSearch").val("Nothing found!");
            console.log("Nothing found in seach");
        }
        else {
            console.log("Find in search");
        }
</script>


