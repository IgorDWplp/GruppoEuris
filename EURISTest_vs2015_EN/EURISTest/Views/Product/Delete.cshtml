@model EURIS.Entities.Product

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Delete</h2>
<fieldset>
    <div class="form-group">
        <label for="description">Description:</label>
        @Html.DisplayFor(model => model.Description)
    </div>
    <div class="form-group">
        <label for="description">Code:</label>
        @Html.DisplayFor(model => model.Code)
    </div>
</fieldset>


<button type="button" class="btn btn-primary" data-toggle="modal" data-target="#del">
    Delete
</button>



<!-- Modal -->
<div class="modal fade" id="del" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Delete UI</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <h3>Are you sure you want to delete this?</h3>
                <br />
                <div class="form-group">
                    <label for="description">ID:</label>
                    @Html.DisplayFor(model => model.Id)
                </div>
                <div class="form-group">
                    <label for="description">Description:</label>
                    @Html.DisplayFor(model => model.Description)
                </div>
                <div class="form-group">
                    <label for="description">Code:</label>
                    @Html.DisplayFor(model => model.Code)
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="window.location='/Product/DeleteProduct/@Model.Id'">Delete</button>
            </div>
        </div>
    </div>
</div>

