@*@model EURIS.Entities.LocalDbEntities*@
@model EURIS.Entities.Product

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Edit</h2>

@using (Html.BeginForm("Edit", "Product", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m.Id)

<div class="form-group">
    @Html.LabelFor(m => m.Code, htmlAttributes: new { @class = "control-label col-md-2" })
    <div class="col-md-10">
        @Html.TextBoxFor(m => m.Code)
        @Html.ValidationMessageFor(model => model.Code, "", new { @class = "text-danger" })
    </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Description, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextBoxFor(m => m.Description)
            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "control-label col-md-2" })
        </div>
    </div>
    <input type="submit" value="Save" class="btn btn-primary" />
    }

    <div>
        @Html.ActionLink("Go Back", "Index", "Product", null, new { @class = "ui-button-text" })
    </div>

    @section Scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }
