@model IEnumerable<EURIS.Entities.LocalDbEntities>
@{
    ViewBag.Title = "Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>@ViewBag.Title</h2>

<p>
   >> @Html.ActionLink("Create New", "Create") <<
</p>
<table class="table">
    <tr>

        <th>Id</th>
        <th>Code</th>
        <th>Description</th>
        <th></th>
    </tr>

    @foreach (var item in ViewBag.Products)

    {
    <tr>

        <td>@item.Id</td>
        <td>@item.Code</td>
        <td>@item.Description</td>
        <td>
            <a href="@Url.Action("Edit", "Product", new { id = item.Id })" class="btn btn-secondary">Edit</a>
            <a href="@Url.Action("Details", "Product", new { id = item.Id })" class="btn btn-info">Details</a>
            <a href="@Url.Action("Delete", "Product", new { id = item.Id })" class="btn btn-danger">Delete</a>
        </td>
    </tr>
    }

</table>


<style>
    .a:link, a:visited, a:active {
        color: none !important;
    }

    a {
        text-decoration: none !important;
    }
</style>